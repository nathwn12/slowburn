<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.nathwn.slowburn</id>
  <launchable type="desktop-id">com.nathwn.slowburn.desktop</launchable>

  <name>Slowburn</name>
  <summary>A simple, clean, and cross-platform music player</summary>

  <developer id="io.martpie">
    <name>Pierre de la Martinière</name>
  </developer>
  <developer_name>Pierre de la Martinière</developer_name>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <content_rating type="oars-1.1" />

  <description>
    <p>
      Slowburn aims to be a simple and easy to use music player with a clean UI. You will not find tons of features, as it goal is not to compete with more complete and more famous music players.
    </p>
    <p>
      Here is a little preview though:
    </p>
    <ul>
      <li>💻 Cross-platform music player (Linux, macOS and Windows)</li>
      <li>🎧 Supported formats: mp3, mp4, m4a/aac, flac, wav, ogg, 3gpp</li>
      <li>🔄 Library auto-refresh</li>
      <li>🌟 Playlists</li>
      <li>🎼 Queue management</li>
      <li>➰ Shuffle, loop</li>
      <li>🌄 Covers</li>
      <li>🤓 Dark theme</li>
      <li>🚤 Playback speed control</li>
      <li>😴 Sleep mode blocker</li>
      <li>📥 &lt;code&gt;.m3u&lt;/code&gt; import/export</li>
    </ul>
  </description>

