{
  "name": "slowburn",
  "version": "0.23.7",
  "description": "A Windows media player with slowed reverb and an A-B loop.",
  "bugs": {
    "url": "https://github.com/nathwn12/slowburn/issues"
  },
  "license": "MIT",
  "author": "nathwn12",
  "contributors": [
    "Pierre de la Martinière <pierre.de.la.martiniere@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nathwn12/slowburn"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && node scripts/check-i18n-catalog.mjs",
    "preview": "vp preview",
    "tauri": "tauri",
    "gen:types": "bash scripts/gen.sh",
    "gen:translations": "lingui extract --clean --overwrite",
    "test:typings": "tsc --noEmit --project ./tsconfig.json",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml",
    "postinstall": "simple-git-hooks",
    "knip": "knip"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-query": "5.108.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-log": "2.10.2",
    "@tauri-apps/plugin-notification": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-os": "2.4.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "browserslist": "4.29.5",
    "eventemitter3": "5.0.4",
    "lodash-es": "4.18.1",
    "nanoid": "6.0.2",
    "normalize.css": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-keybinding-component": "2.3.1",
    "semver": "7.8.6",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@lingui/babel-plugin-lingui-macro": "6.12.0",
    "@lingui/cli": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@stylexjs/eslint-plugin": "0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@tanstack/router-plugin": "1.169.0",
    "@tauri-apps/cli": "2.12.6",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "lightningcss": "1.33.0",
    "playwright": "1.65.1",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plugin-svgr": "5.2.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.3.0",
    "@vitest/browser-playwright": "5.1.1"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -f \"$HOME/.config/git/hooks/pre-commit\" ]; then sh \"$HOME/.config/git/hooks/pre-commit\" || exit 1; fi; cd \"$(git rev-parse --show-toplevel)\" || exit 1; [ -x node_modules/.bin/lingui ] || { echo '[pre-commit] lingui CLI not installed - run bun install' >&2; exit 1; }; node_modules/.bin/lingui extract --clean --overwrite || exit 1; git add src/translations"
  },
  "packageManager": "bun@1.4.4",
  "productName": "Slowburn",
  "workspaces": {
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "vite-plus": "1.7.0",
      "vitest": "5.1.1"
    }
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:",
    "js-yaml": "^4.3.2",
    "browserslist": "^4.29.6"
  }
}
